{
  "sourceLanguage" : "en",
  "strings" : {
    "A little cat rests beside the arrow and blinks when you click." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "小猫趴在箭头边，点一下就眨眼。"
          }
        }
      }
    },
    "A short amber pencil that clicks with its tip." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "琥珀色短铅笔，用笔尖指向和点击。"
          }
        }
      }
    },
    "Active on Desktop" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "桌面正在使用"
          }
        }
      }
    },
    "Another copy of Tipwink is restoring the cursor. Try again in a moment." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "另一个纸尖进程正在处理恢复，请稍后重试。"
