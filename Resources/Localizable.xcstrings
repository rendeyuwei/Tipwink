    "Cursor Themes" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "光标主题"
          }
        }
      }
    },
    "Custom system pointer colors override desktop themes. Open Settings below and click Reset Colors. Tipwink will apply the theme when you return. You can keep your pointer size." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "系统自定义指针颜色会覆盖桌面主题。用下方按钮打开设置，点「重设颜色」，回到纸尖时会自动应用。指针大小可以保留。"
          }
        }
      }
    },
    "Dark" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "深色"
          }
        }
      }
    },
    "Desktop themes are unavailable on this Mac. You can still try them in the preview." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当前 macOS 上暂时无法应用桌面主题。你仍可在窗口内试用。"
